{
  "name": "dsh-whale-rice",
  "description": "A chibi whale maid who keeps eating white rice while DeepSeek is generating — inside DSH or anywhere on your desktop.",
  "version": "0.2.7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/host/*.test.ts",
    "dev": "node scripts/build.mjs && node dev/serve.mjs",
    "sprites": "python3 scripts/sprites/build_sprites.py && python3 scripts/sprites/flows.py && python3 scripts/sprites/build_treasure.py"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/overlay.js",
    "lib/overlay.html",
    "lib/whale-overlay",
    "lib/whale-overlay.exe",
    "lib/whale-overlay.exe.config",
    "lib/Microsoft.Web.WebView2.Core.dll",
    "lib/WebView2Loader.dll",
    "native/macos/WhaleOverlay.swift",
    "native/windows/WhaleOverlay.csproj",
    "native/windows/Program.cs",
    "native/windows/OverlayWindow.cs",
    "native/windows/Native.cs",
    "native/windows/app.manifest",
    "cordis.patch.yml",
    "assets/sprites/whale.webp",
    "assets/sprites/whale.json",
    "assets/treasure/*.webp",
    "assets/LICENSE-ARTWORK",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "license": "MIT AND CC-BY-NC-SA-4.0"
}
